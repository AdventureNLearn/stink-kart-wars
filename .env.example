# Copy to .env.local for local overrides. Never commit real secrets.
# The game runs fully client-side without these.

# Optional production Postgres (defaults to in-browser PGLite)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Optional auth (only if you wire OAuth providers)
# BETTER_AUTH_SECRET=generate-a-long-random-string
# BETTER_AUTH_URL=http://localhost:8080
